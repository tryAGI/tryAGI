{
  "issue_limit": 100,
  "workflows": {
    "auto_update_file": "auto-update.yml",
    "publish_file": "dotnet.yml",
    "new_repo_days": 7
  },
  "signals": {
    "run_limit": 5,
    "ignored_skip_signal_repos": [
      "OpenAI"
    ]
  },
  "operation_visibility": {
    "required_public_operations": [
      {
        "repo": "Chroma",
        "spec_path": "src/libs/Chroma/openapi.json",
        "method": "POST",
        "path": "/api/v2/reset",
        "operation_id": "reset",
        "reason": "System.ResetAsync is a supported public contract; see tryAGI/Chroma#146"
      }
    ]
  },
  "workspace": {
    "allowed_ahead_repositories": [
      {
        "repo": "LangChainChat",
        "reason": "upstream repository is read-only for the current GitHub identity"
      }
    ],
    "allowed_no_upstream_repositories": [
      {
        "repo": "LocalSpeechToText",
        "reason": "local-only repository has no remote destination"
      }
    ]
  },
  "smoke": {
    "local_container_repositories": [
      {
        "repo": "Chroma",
        "environment_name": "CHROMA_TEST_ENVIRONMENT",
        "environment_value": "Container"
      },
      {
        "repo": "Qdrant",
        "environment_name": "QDRANT_TEST_ENVIRONMENT",
        "environment_value": "Container"
      },
      {
        "repo": "LabelStudio"
      },
      {
        "repo": "Weaviate"
      }
    ]
  }
}
