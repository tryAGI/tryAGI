{
  "issue_limit": 100,
  "workflows": {
    "auto_update_file": "auto-update.yml",
    "publish_file": "dotnet.yml",
    "new_repo_days": 7
  },
  "signals": {
    "run_limit": 5,
    "ignored_skip_signal_repos": [
      "OpenAI"
    ]
  },
  "smoke": {
    "local_container_repositories": [
      {
        "repo": "Chroma",
        "environment_name": "CHROMA_TEST_ENVIRONMENT",
        "environment_value": "Container"
      },
      {
        "repo": "Qdrant",
        "environment_name": "QDRANT_TEST_ENVIRONMENT",
        "environment_value": "Container"
      }
    ]
  }
}
